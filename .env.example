# Copy to .env; never commit your filled-in file.
# Credentials in DAEMON_URL must be URL-encoded if they contain reserved characters.
# Replace these example credentials and host before starting.
DAEMON_URL=http://CHANGE_ME_USER:CHANGE_ME_PASSWORD@host.docker.internal:33873
ELECTRUM_PUBLIC_HOST=electrum.example.org
ELECTRUM_CERTFILE=fullchain.pem
ELECTRUM_KEYFILE=privkey.pem
MAX_SESSIONS=1000
HISTORY_COMPACTION_THRESHOLD=50000
DONATION_ADDRESS=
DASHBOARD_PORT=8002
