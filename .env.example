# Copy to .env; never commit your filled-in file.
# Credentials in DAEMON_URL must be URL-encoded if they contain reserved characters.
# Replace these example credentials and host before starting.
# Optional prebuilt daemon: set this to a reviewed ghcr.io/lostinbtc/pepecoin-electrumx@sha256:... reference.
# Leave unset for a local source build. Never copy an unverified example digest.
# ELECTRUM_IMAGE=
DAEMON_URL=http://CHANGE_ME_USER:CHANGE_ME_PASSWORD@host.docker.internal:33873
ELECTRUM_PUBLIC_HOST=electrum.example.org
ELECTRUM_CERTFILE=fullchain.pem
ELECTRUM_KEYFILE=privkey.pem
MAX_SESSIONS=1000
HISTORY_COMPACTION_THRESHOLD=50000
DONATION_ADDRESS=
# Optional dashboard ONLY for its private web UI / dashboard-dependent integrations.
# Wallets and direct Electrum RPC clients do not need it. Exact security patch:
# https://github.com/lostinbtc/pepecoin-electrumx/commit/d02676e5e4f257419247ded31a538306bdd29793.patch
# Set to a reviewed ghcr.io/lostinbtc/pepecoin-electrumx-dashboard@sha256:... digest.
# DASHBOARD_IMAGE=
DASHBOARD_PORT=8002
